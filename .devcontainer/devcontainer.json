{
  "name": "Zephyr",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",

  // OpenOCD auf dem Host finden (siehe openocd-remote):
  // Linux: host.docker.internal -> Docker-Bridge (172.17.0.1)
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  // WSL: Windows-Host-IP bei jedem Start neu ermitteln
  "initializeCommand": "if grep -qi microsoft /proc/version 2>/dev/null; then ip route show default | awk '{print $3; exit}' > .devcontainer/.openocd-host; else rm -f .devcontainer/.openocd-host; fi",

  "mounts": [
    "source=zephyr-workdir,target=/workdir,type=volume"
  ],

  "containerEnv": {
    "ZEPHYR_REVISION": "v4.4.0",
    "SDK_TOOLCHAINS": "arm-zephyr-eabi",

    "ZEPHYR_BASE": "/workdir/zephyr",
    "VIRTUAL_ENV": "/workdir/.venv",
    "CCACHE_DIR": "/workdir/.ccache",

    "OPENOCD_REMOTE_HOST_FILE": "${containerWorkspaceFolder}/.devcontainer/.openocd-host"
  },
  "remoteEnv": {
    "PATH": "/workdir/.venv/bin:${containerEnv:PATH}"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "hostRequirements": {
    "cpus": 4,
    "memory": "6gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "marus25.cortex-debug",
        "trond-snekvik.devicetree",
        "trond-snekvik.kconfig-lang"
      ],
      "settings": {
        "C_Cpp.default.compileCommands": [
          "${workspaceFolder}/build/requester/compile_commands.json",
          "${workspaceFolder}/build/responder/compile_commands.json"
        ],
        "cmake.configureOnOpen": false,
        "cmake.automaticReconfigure": false,
        "python.defaultInterpreterPath": "/workdir/.venv/bin/python",
        "python.terminal.activateEnvironment": false 
      }
    }
  }
}