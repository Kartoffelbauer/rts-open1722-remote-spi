#!/usr/bin/env python3
"""
Stand-in for 'openocd' in the dev container.

Docker Desktop (macOS/Windows) can't pass USB devices into the container.
So OpenOCD runs on the host, where the board is plugged in, and this script
turns the calls of 'west flash' / 'west debug' into a GDB connection to that
OpenOCD. The firmware is transferred over the GDB connection, so the host
needs no access to the build files.

Host side: start OpenOCD once, with the board plugged in, as described in
docs/getting-started.md (step 2).

The host is found automatically, the first reachable one wins:
  1. OPENOCD_REMOTE_HOST, if set (then only this one)
  2. The IP in OPENOCD_REMOTE_HOST_FILE (written by initializeCommand under
     WSL: the Windows host IP from 'ip route show default')
  3. host.docker.internal (Docker Desktop; on Linux through
     --add-host=host.docker.internal:host-gateway -> 172.17.0.1)
"""

import glob
import os
import re
import socket
import subprocess
import sys
import tempfile
import threading

HOST = None  # set by check_host()
GDB_PORT = int(os.environ.get("OPENOCD_REMOTE_GDB_PORT", "3333"))


def host_hint(hosts):
    tried = ", ".join(f"{h}:{GDB_PORT}" for h in hosts)
    return f"""
No OpenOCD reachable on the host ({tried}).
Plug the board into the PC over USB and start OpenOCD on the host (not in the
container) as described in docs/getting-started.md, step 2.
"""


def candidate_hosts():
    if os.environ.get("OPENOCD_REMOTE_HOST"):
        return [os.environ["OPENOCD_REMOTE_HOST"]]
    hosts = []
    try:
        with open(os.environ.get("OPENOCD_REMOTE_HOST_FILE", "")) as f:
            if ip := f.read().strip():
                hosts.append(ip)
    except OSError:
        pass
    hosts.append("host.docker.internal")
    return hosts


def die(msg):
    print(f"openocd-remote: {msg}", file=sys.stderr)
    sys.exit(1)


def parse_args(argv):
    """Returns the -c commands after 'init' and the requested GDB port."""
    cmds, gdb_port, after_init = [], GDB_PORT, False
    it = iter(argv)
    for arg in it:
        if arg in ("-s", "-f", "-d", "-l", "--search", "--file", "--log_output"):
            next(it, None)
        elif arg in ("-c", "--command") or arg.startswith("-c"):
            # The runner sometimes passes '-c init' as a single argument
            cmd = (next(it, "") if arg in ("-c", "--command") else arg[2:]).strip()
            m = re.fullmatch(r"gdb_port\s+(\d+)", cmd)
            if m:
                gdb_port = int(m.group(1))
            elif cmd == "init":
                after_init = True
            elif after_init and cmd != "targets":
                cmds.append(cmd)
    return cmds, gdb_port


def check_host():
    global HOST
    hosts = candidate_hosts()
    for host in hosts:
        try:
            socket.create_connection((host, GDB_PORT), timeout=3).close()
            HOST = host
            return
        except OSError:
            pass
    die(host_hint(hosts))


def find_gdb():
    gdbs = sorted(glob.glob("/workdir/zephyr-sdk-*/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"))
    if not gdbs:
        die("arm-zephyr-eabi-gdb not found in the Zephyr SDK")
    return gdbs[-1]


def elf_for(image):
    """GDB loads the ELF file next to the .hex/.bin most reliably."""
    elf = os.path.splitext(image)[0] + ".elf"
    return elf if os.path.exists(elf) else image


def flash(cmds):
    gdb_cmds = ["set confirm off", "set pagination off",
                f"target remote {HOST}:{GDB_PORT}"]
    for cmd in cmds:
        load = re.fullmatch(r"(?:flash write_image(?: erase)?|load_image)\s+(\S+).*", cmd)
        verify = re.fullmatch(r"verify_image\s+(\S+).*", cmd)
        if cmd == "shutdown":
            break
        elif load:
            gdb_cmds += [f"file {elf_for(load.group(1))}", "load"]
        elif verify:
            gdb_cmds += [f"file {elf_for(verify.group(1))}", "compare-sections"]
        else:
            gdb_cmds.append(f"monitor {cmd}")
    gdb_cmds.append("disconnect")

    # As a script instead of -ex: stops at the first error and exits with a non-zero code
    with tempfile.NamedTemporaryFile("w", suffix=".gdb") as script:
        script.write("\n".join(gdb_cmds) + "\n")
        script.flush()
        result = subprocess.run([find_gdb(), "-q", "-batch", "-nx", "-x", script.name])
    if result.returncode != 0:
        die("flashing failed")


def pipe(src, dst):
    try:
        while data := src.recv(65536):
            dst.sendall(data)
    except OSError:
        pass
    finally:
        for s in (src, dst):
            try:
                s.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass


def serve(local_port):
    """'west debug'/'debugserver': forwards a local GDB port to OpenOCD on the host."""
    srv = socket.create_server(("127.0.0.1", local_port))
    print(f"openocd-remote: localhost:{local_port} -> {HOST}:{GDB_PORT}", file=sys.stderr)
    while True:
        client, _ = srv.accept()
        try:
            upstream = socket.create_connection((HOST, GDB_PORT), timeout=5)
            upstream.settimeout(None)
        except OSError:
            client.close()
            print(host_hint([HOST]), file=sys.stderr)
            continue
        threading.Thread(target=pipe, args=(client, upstream), daemon=True).start()
        threading.Thread(target=pipe, args=(upstream, client), daemon=True).start()


def main():
    argv = sys.argv[1:]
    if "--version" in argv or "-v" in argv:
        # The Zephyr runner reads the version to check for thread awareness
        print("Open On-Chip Debugger 0.12.0 (openocd-remote wrapper)")
        return

    cmds, gdb_port = parse_args(argv)
    check_host()
    if "shutdown" in cmds:
        flash(cmds)
    else:
        serve(gdb_port)


if __name__ == "__main__":
    main()
